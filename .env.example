PORT=3000
SESSION_SECRET=troque-este-segredo-local
DATABASE_PATH=./data/analytics.sqlite
EXPORTS_DIR=./exports

# Use o Instagram App ID/Secret do produto Instagram > API setup with Instagram login.
# META_APP_ID/META_APP_SECRET continuam aceitos como fallback, mas o OAuth do Instagram
# precisa das credenciais de Instagram para evitar "Invalid platform app".
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Crie um app no Meta for Developers com Instagram API e configure este redirect URI.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/auth/instagram/callback

# Opcional para coleta por CLI. Nao commitar .env.
META_ACCESS_TOKEN=

# Versao atual da Graph API em 30/08/2026. Pode ser trocada sem editar codigo.
META_GRAPH_VERSION=v26.0
META_GRAPH_BASE_URL=https://graph.instagram.com

# Permissoes para Instagram API com Instagram Login.
META_SCOPES=instagram_business_basic,instagram_business_manage_insights,instagram_business_manage_comments
